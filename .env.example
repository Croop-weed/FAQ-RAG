SUPPORT_ASSISTANT_APP_NAME=customer-support-assistant
SUPPORT_ASSISTANT_ENVIRONMENT=development
SUPPORT_ASSISTANT_LOG_LEVEL=INFO
SUPPORT_ASSISTANT_DATABASE_URL=sqlite+aiosqlite:///./data/support_assistant.db

# Generation remains unconfigured; retrieval and reranking models are baselines.
SUPPORT_ASSISTANT_LLM_PROVIDER=not-configured
SUPPORT_ASSISTANT_LLM_MODEL=not-configured
SUPPORT_ASSISTANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SUPPORT_ASSISTANT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
SUPPORT_ASSISTANT_EVALUATION_TOP_K=5
SUPPORT_ASSISTANT_EMBEDDING_CACHE_DIR=models/cache/embeddings

SUPPORT_ASSISTANT_BM25_TOP_K=20
SUPPORT_ASSISTANT_VECTOR_TOP_K=20
SUPPORT_ASSISTANT_FUSION_TOP_K=20
SUPPORT_ASSISTANT_RRF_K=60
SUPPORT_ASSISTANT_RERANK_TOP_K=5